{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "tsconfig": "tsconfig.json",
  "name": "@solisware/electron-menu-i18next API",
  "includeVersion": true,
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "navigationLinks": {
    "SolisWare": "https://solisware.com",
    "GitHub": "https://github.com/SolisWare/electron-menu-i18next",
    "npm": "https://www.npmjs.com/package/@solisware/electron-menu-i18next"
  },
  "customFooterHtml": "Copyright &copy; 2026 <a href=\"https://solisware.com\">SolisWare</a> and contributors. Licensed under the <a href=\"https://github.com/SolisWare/electron-menu-i18next/blob/main/LICENSE\">MIT License</a>.",
  "validation": {
    "invalidLink": true,
    "notExported": true
  },
  "treatWarningsAsErrors": true
}
