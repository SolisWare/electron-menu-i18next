{
  "name": "@solisware/electron-menu-i18next",
  "version": "0.1.0",
  "description": "Localize Electron's role-based native menu labels with i18next, in the main process.",
  "keywords": [
    "electron",
    "i18next",
    "i18n",
    "localization",
    "menu",
    "native-menu"
  ],
  "author": {
    "name": "SolisWare",
    "email": "solisware@mail.com",
    "url": "https://solisware.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/SolisWare/electron-menu-i18next",
  "bugs": {
    "url": "https://github.com/SolisWare/electron-menu-i18next/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "npm run build && npm run test:compatibility && npm run test:functionality && npm run test:integration && npm run test:consumer:javascript && npm run test:consumer:typescript",
    "test:compatibility": "node test/framework/run-tests.mjs test/compatibility",
    "test:consumer:javascript": "node test/fixtures/run-javascript-consumers.mjs",
    "test:consumer:typescript": "tsc --project test/fixtures/typescript-consumer/tsconfig.json",
    "test:functionality": "node test/framework/run-tests.mjs test/functionality",
    "test:integration": "node test/framework/run-tests.mjs test/integration",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "i18next": ">=21.0.0"
  },
  "devDependencies": {
    "i18next": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "npm@8.11.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SolisWare/electron-menu-i18next.git"
  }
}
