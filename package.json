{
  "name": "electron-menu-i18next",
  "version": "0.1.0",
  "description": "Localize Electron's role-based native menu labels with i18next, in the main process.",
  "keywords": [
    "electron",
    "i18next",
    "i18n",
    "localization",
    "menu",
    "native-menu"
  ],
  "author": "SolisWare <https://github.com/SolisWare>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && npm run test:compatibility && npm run test:functionality",
    "test:compatibility": "node test/compatibility/esm-import.test.mjs && node test/compatibility/commonjs-require.test.cjs",
    "test:functionality": "node test/functionality/run-tests.mjs",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "i18next": ">=21.0.0"
  },
  "devDependencies": {
    "i18next": "^24.0.0",
    "tsup": "^7.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soliswaredev/electron-menu-i18next"
  }
}
